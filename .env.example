# --- Diagrid Catalyst (from the Catalyst console or `diagrid` CLI) ---
# gRPC: host:port with ?tls=true (the https:// form still works but the SDK warns it is deprecated)
DAPR_GRPC_ENDPOINT=grpc-<project>.cloud.r1.diagrid.io:443?tls=true
# HTTP: a DIFFERENT host, starts with http- not grpc-
DAPR_HTTP_ENDPOINT=https://http-<project>.cloud.r1.diagrid.io
# macOS python.org installs: uncomment if you see CERTIFICATE_VERIFY_FAILED
# SSL_CERT_FILE=/path/to/.venv/lib/python3.11/site-packages/certifi/cacert.pem
# GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/path/to/.venv/lib/python3.11/site-packages/certifi/cacert.pem
DAPR_API_TOKEN=diagrid://...

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# --- Demo input (optional; use place_id "sample" to skip) ---
GOOGLE_MAPS_API_KEY=AIza...
